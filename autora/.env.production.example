# ============================================
# Autora Production Environment Configuration
# ============================================
# Copy to .env and fill in all required values
# Required values are marked with [REQUIRED]

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=         # [REQUIRED] Strong password for PostgreSQL
POSTGRES_DB=autora

# --- Redis ---
REDIS_PASSWORD=            # [REQUIRED] Strong password for Redis

# --- Application ---
JWT_SECRET=                # [REQUIRED] Random 64-char hex: openssl rand -hex 32
CORS_ORIGINS=https://admin.autora.uz
ADMIN_PORT=80

# --- SMS (Eskiz.uz) ---
ESKIZ_EMAIL=               # [REQUIRED] Eskiz.uz account email
ESKIZ_PASSWORD=            # [REQUIRED] Eskiz.uz account password
ESKIZ_BASE_URL=https://notify.eskiz.uz

# --- Firebase Cloud Messaging ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Payme Payment ---
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# --- Click Payment ---
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# --- Admin Seed (run once) ---
ADMIN_PHONE=+998900000000
ADMIN_PASSWORD=            # [REQUIRED] Set a strong admin password
ADMIN_NAME=Admin
